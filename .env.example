# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Server-only. Never exposed to the browser. Used by scripts/seed-users.mjs and,
# later, by sync jobs that must bypass RLS on purpose.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Connect -> Connection string -> Session pooler, with the password percent-encoded.
# Used to push migrations and the seed without a CLI login:
#   npx supabase db push --db-url "<this value>" --yes   (add --include-seed for seed.sql)
SUPABASE_DB_URL=

# Database password, as set when the project was created. Optional; the Supabase CLI
# reads it, and it's the easiest way to build SUPABASE_DB_URL.
SUPABASE_DB_PASSWORD=

# Password given to the four seeded demo users.
SEED_USER_PASSWORD=PostSales!2026

# Server-only. Set to exactly "true" to allow password sign-in on a DEPLOYED build.
# Off by default: a deployment is Microsoft-only. Turned on for the Vercel deploy
# (2026-09-22) because Microsoft sign-in is not configured yet. Every real owner's
# password then works over the public internet, so clear it once Microsoft works.
ALLOW_PASSWORD_SIGN_IN=

# Optional, server-only. Claude reads natural-language collateral searches, writes drafts
# and reviews them. Without it, search falls back to a plain word match and drafts start
# from the template with the known details filled in.
ANTHROPIC_API_KEY=

# --- Sending (Phase 5) -------------------------------------------------------
# Public address of this app, for unsubscribe links in emails.
APP_BASE_URL=http://localhost:3001

# Shared secret for /api/jobs/send and /api/jobs/track (at least 16 characters).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Encrypts Microsoft refresh tokens before they're stored. 32 bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAILBOX_TOKEN_KEY=

# Microsoft 365 mailbox connection (Azure app registration "Lyzr Comms Tracker").
# Add http://localhost:3001/mailbox/callback as a Web redirect URI, and the delegated
# Graph permissions Mail.Send, Mail.ReadBasic, User.Read and offline_access.
MICROSOFT_CLIENT_ID=eb37cade-21f4-492e-b3f2-a5656911704a
MICROSOFT_TENANT_ID=4b1018eb-9480-4542-89d0-4e6233aba226
MICROSOFT_CLIENT_SECRET=

# --- Leadership enrichment -----------------------------------------------------
# Apollo API key (Settings -> Integrations -> API in Apollo), for Find people. Searching is free;
# adding a person reveals their email and uses credits.
APOLLO_API_KEY=

# --- Cortex sync (accounts, owners, contacts) ------------------------------------
# Helix: clients, projects and project contacts. Sent as an x-api-key header.
HELIX_BASE_URL=https://applied-ai.lyzr.app
HELIX_API_KEY=
# Compass: lifecycle, CSM, health, commercials, use cases, contacts. Sent as a Bearer token.
COMPASS_BASE_URL=https://cs-intelligence-be.lyzr.app
COMPASS_API_KEY=

# --- Skott collateral ------------------------------------------------------------
# Skott's MCP server (list_kb, search_kb). The key is sent as a Bearer token.
SKOTT_MCP_URL=https://skott-2-0.vercel.app/api/mcp
SKOTT_API_KEY=
