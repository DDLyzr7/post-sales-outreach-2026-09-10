# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Server-only. Never exposed to the browser. Used by scripts/seed-users.mjs and,
# later, by sync jobs that must bypass RLS on purpose.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional: Supabase project settings -> Database -> Connection string (session pooler).
# Only needed if you want `npm run db:seed` to apply supabase/seed.sql with psql.
SUPABASE_DB_URL=

# Password given to the four seeded demo users.
SEED_USER_PASSWORD=PostSales!2026
